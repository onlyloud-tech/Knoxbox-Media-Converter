{
  "name": "knoxbox-media-converter",
  "version": "0.3.6",
  "description": "Desktop media converter and movie-pack builder for KnoxBox Television and VHS",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "package:win": "npm run build && electron-builder --win portable",
    "test:integration": "tsx script/integration-test.ts",
    "test:security": "tsx script/security-test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.knoxbox.mediaconverter",
    "productName": "Knoxbox Media Converter",
    "asar": true,
    "files": [
      "dist/index.cjs",
      "dist/public/**/*",
      "electron/**/*",
      "build/icon.ico",
      "LICENSE",
      "LICENSES/**/*",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "vendor/ffmpeg"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable",
      "artifactName": "Knoxbox-Media-Converter-${version}.exe"
    }
  }
}
