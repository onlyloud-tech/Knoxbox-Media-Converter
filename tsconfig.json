{
  "include": ["client/src/App.tsx", "client/src/main.tsx", "server/**/*", "script/**/*"],
  "exclude": ["node_modules", "dist", "release"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"]
  }
}
